# This is the base style for the "SpiffyPlots" package.
# https://github.com/JRBCH/spiffyplots

# Default color cycle: Paul Tol's vibrant scheme reordered.
axes.prop_cycle : cycler('color', ['0077BB', 'CC3311', '009988', '33BBEE', 'EE7733', 'EE3377', '000000', 'BBBBBB'])

# Default colormap: Paul Tol's iridescent
image.cmap: tol.iridescent

# Set default figure size
figure.figsize : 4, 2.5

# Remove top and right spines
axes.spines.right : False
axes.spines.top : False

# Set x axis
xtick.direction : out
xtick.major.size : 3
xtick.major.width : 0.5
xtick.minor.visible : False
xtick.top : False

# Set y axis
ytick.direction : out
ytick.major.size : 3
ytick.major.width : 0.5
ytick.minor.visible : False
ytick.right : False

# Set line widths
axes.linewidth : 0.5
grid.linewidth : 0.5
lines.linewidth : 1

# Set Marker size
lines.markersize: 4.0

# Remove legend frame
legend.frameon : False

# CONSTRAINED LAYOUT
# # # # # # # # # # # # #

figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.0
figure.constrained_layout.w_pad: 0.0
figure.constrained_layout.hspace: 0.05
figure.constrained_layout.wspace: 0.05

# FONTS
# # # # #

font.family  : sans-serif
#font.style   : normal
#font.variant : normal
#font.weight  : normal
#font.stretch : normal

font.size             : 7
axes.labelsize        : 8
axes.titlesize        : 8
xtick.labelsize       : 7
ytick.labelsize       : 7
legend.fontsize       : 7
legend.title_fontsize : 7
figure.titlesize      : 8
figure.labelsize      : 8

# Helvetica first, then Arial and metric-compatible clones for machines without it.
font.sans-serif : Helvetica, Arial, Nimbus Sans, Liberation Sans, DejaVu Sans

# `sans` follows font.sans-serif above, so math renders in the same face as the text.
mathtext.fontset : custom
mathtext.rm      : sans
mathtext.it      : sans:italic
mathtext.bf      : sans:bold
mathtext.cal     : sans

# Journals usually require embedded TrueType fonts, not Type 3, and editable text, see below.
# https://research-figure-guide.nature.com/figures/building-and-exporting-figure-panels/
pdf.fonttype : 42
ps.fonttype  : 42
svg.fonttype : none

# Histogram bins
hist.bins: 20

# Errorbar caps
errorbar.capsize: 2.0

# Patch settings
patch.edgecolor: white
patch.force_edgecolor: True
patch.linewidth: 0.5

# SCATTERPLOT
scatter.edgecolors: none
