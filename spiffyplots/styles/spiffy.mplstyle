# This is the base style for the "SpiffyPlots" package.
# Visit us on GitHub: https://github.com/JRBCH/spiffyplots

# Color cycle: spiffyplots.colors.SPIFFY_CYCLE, Paul Tol's vibrant scheme reordered.
# Keep the two in step; tests/test_styles.py checks.
axes.prop_cycle : cycler('color', ['0077BB', 'CC3311', '009988', '33BBEE', 'EE7733', 'EE3377', '000000', 'BBBBBB'])

# Default colormap: Paul Tol's iridescent, registered by spiffyplots on import.
# This is why `import spiffyplots` is needed before `plt.style.use("spiffy")`: a
# sheet naming an unregistered colormap applies silently, then fails at draw time.
image.cmap: tol.iridescent

# Set default figure size
figure.figsize : 3, 3

# Remove top and right spines
axes.spines.right : False
axes.spines.top : False

# Set x axis
xtick.direction : out
xtick.major.size : 3
xtick.major.width : 0.5
xtick.minor.visible : False
xtick.top : False

# Set y axis
ytick.direction : out
ytick.major.size : 3
ytick.major.width : 0.5
ytick.minor.visible : False
ytick.right : False

# Set line widths
axes.linewidth : 0.5
grid.linewidth : 0.5
lines.linewidth : 1

# Set Marker size
lines.markersize: 4.0

# Remove legend frame
legend.frameon : False

# CONSTRAINED LAYOUT
# # # # # # # # # # # # #

figure.constrained_layout.use: True
#figure.constrained_layout.h_pad:  0.04167  # Padding around axes objects. Float representing
#figure.constrained_layout.w_pad:  0.04167  # inches. Default is 3./72. inches (3 pts)
#figure.constrained_layout.hspace: 0.02     # Space between subplot groups. Float representing
#figure.constrained_layout.wspace: 0.02     # a fraction of the subplot widths being separated.

# FONTS
# # # # #

font.family  : sans-serif
#font.style   : normal
#font.variant : normal
#font.weight  : normal
#font.stretch : normal
font.size    : 8.0

# Nature and most journals ask for a "standard" sans-serif face, naming Helvetica
# or Arial. The clones after them are metrically compatible (Nimbus Sans with
# Helvetica, Liberation Sans with Arial), so a machine without the real thing
# still lays text out at the same widths. DejaVu Sans is matplotlib's own and is
# the only entry guaranteed to be present.
font.sans-serif : Helvetica, Arial, Nimbus Sans, Liberation Sans, DejaVu Sans

# Render math in the same face as the surrounding text, so `$\Delta w$` in an
# axis label does not switch typeface mid-string. `sans` is a generic family
# alias, so it follows font.sans-serif above and stays matched to whichever
# entry actually resolved. Do not write `sans-serif` here: the rcParam is
# validated as a fontconfig pattern and the hyphen is a parse error.
#
# Stretchy glyphs (\sqrt bars, \left( \right) delimiters) do not exist in these
# faces and come from matplotlib's fallback math font. That is cosmetic; it logs
# "No TeX to Unicode mapping for '__radicalbig__'" and renders correctly.
mathtext.fontset : custom
mathtext.rm      : sans
mathtext.it      : sans:italic
mathtext.bf      : sans:bold

# Journals usually require embedded TrueType fonts, not Type 3, and editable text, see below.
# https://research-figure-guide.nature.com/figures/building-and-exporting-figure-panels/
pdf.fonttype : 42
ps.fonttype  : 42
svg.fonttype : none

# Histogram bins
hist.bins: 20

# Errorbar caps
errorbar.capsize: 2.0

# Patch settings
patch.edgecolor: white
patch.force_edgecolor: True
patch.linewidth: 0.5

# SCATTERPLOT
scatter.edgecolors: none
