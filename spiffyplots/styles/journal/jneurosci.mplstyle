# Journal of Neuroscience: 85 mm single column, 116 mm 1.5 columns, 176 mm double column.
# Text 6-8 pt.
# Source, checked 2026-08-06:
# https://www.jneurosci.org/content/information-authors
#
# Generated from spiffyplots.journals by `python -m spiffyplots._genstyles`.
# Edit the spec there, not this file.

figure.figsize : 6.9291, 4.3307   # 176 x 110 mm

# 7 and 8 pt sit inside the 6-8 pt range; change them freely.
font.size             : 7
axes.labelsize        : 8
axes.titlesize        : 8
xtick.labelsize       : 7
ytick.labelsize       : 7
legend.fontsize       : 7
legend.title_fontsize : 7
figure.titlesize      : 8
figure.labelsize      : 8

pdf.fonttype : 42
ps.fonttype  : 42
svg.fonttype : none
savefig.dpi  : 300
